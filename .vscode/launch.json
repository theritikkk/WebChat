{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Gateway (4000)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "program": "${workspaceFolder}/services/gateway/src/index.js",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Auth (3001)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "program": "${workspaceFolder}/services/auth/src/index.js",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Messages (3003)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "program": "${workspaceFolder}/services/messages/src/index.js",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Chat / Socket.io (5000)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "program": "${workspaceFolder}/services/chat/src/index.js",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Client (Vite)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev:client",
      "cwd": "${workspaceFolder}"
    }
  ],
  "compounds": [
    {
      "name": "All backend services",
      "configurations": ["Gateway (4000)", "Auth (3001)", "Messages (3003)", "Chat / Socket.io (5000)"],
      "stopAll": true
    }
  ]
}
