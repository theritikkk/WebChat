# Copy to .env in repo root and adjust. All services load from ../../.env via dotenv.

# ⚠️  REQUIRED: Change this before ANY deployment. Services refuse to start in production
#    if this is still set to the default. Generate with: openssl rand -hex 64
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ── Service URLs (local dev defaults) ─────────────────────────────────────────
AUTH_SERVICE_URL=http://127.0.0.1:3001
MESSAGES_SERVICE_URL=http://127.0.0.1:3003
CHAT_SERVICE_PUBLIC_URL=http://127.0.0.1:5000
UPLOADS_SERVICE_URL=http://127.0.0.1:3004

# ── Auth → Postgres ────────────────────────────────────────────────────────────
POSTGRES_USER=webchat
POSTGRES_PASSWORD=webchat
POSTGRES_DB=webchat
DATABASE_URL=postgres://webchat:webchat@127.0.0.1:5432/webchat

# ── Messages → MongoDB ─────────────────────────────────────────────────────────
MONGO_URI=mongodb://127.0.0.1:27017/webchat

# ── Redis (Socket.io adapter + presence cache + membership cache) ──────────────
REDIS_URL=redis://127.0.0.1:6379

# ── RabbitMQ (message queue — Chat → Worker → Mongo) ──────────────────────────
RABBITMQ_URL=amqp://webchat:webchat@127.0.0.1:5672
RABBITMQ_USER=webchat
RABBITMQ_PASS=webchat

# ── MinIO / S3 Object Storage (file uploads) ───────────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=webchat-uploads

# ── Elasticsearch (full-text message search) ───────────────────────────────────
ELASTICSEARCH_URL=http://127.0.0.1:9200
ES_INDEX=webchat-messages

# ── Service ports ─────────────────────────────────────────────────────────────
PORT_GATEWAY=4000
PORT_AUTH=3001
PORT_MESSAGES=3003
PORT_CHAT=5000
PORT_UPLOADS=3004

# ── CORS (comma-separated origins for gateway + chat) ─────────────────────────
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173


# ── AWS S3 Object Storage (replaces MinIO) ─────────────────────────────────────
# Remove the MINIO_* vars and replace with these:

AWS_REGION=ap-south-1                         # your bucket's region
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE        # IAM user access key
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG  # IAM user secret key
S3_BUCKET=webchat-videos                      # bucket name (create it first)

# Set to "true" if you want public video URLs (no expiry).
# Leave unset (or "false") for private bucket + presigned GET URLs.
S3_PUBLIC_BUCKET=true

# Optional TTL overrides (defaults shown)
# S3_PUT_TTL_SECONDS=300    # how long the browser has to start the upload
# S3_GET_TTL_SECONDS=3600   # how long a signed download URL lasts

# ── OpenTelemetry Distributed Tracing (optional) ─────────────────────────────
# Leave OTEL_ENABLED unset (defaults true) in dev when running a local collector,
# or set to "false" to disable tracing entirely.
# OTEL_ENABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318   # Jaeger / Grafana Tempo / any OTLP collector
# OTEL_SERVICE_NAME is set per-service automatically (webchat-gateway, webchat-auth, etc.)

# ── Node environment ───────────────────────────────────────────────────────
# NODE_ENV=production   # enables JWT_SECRET guard and stricter error handling