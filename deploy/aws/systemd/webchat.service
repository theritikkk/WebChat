[Unit]
Description=WebChat Docker Compose Stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/webchat
EnvironmentFile=/opt/webchat/.env.production
ExecStart=/usr/bin/docker compose -f deploy/aws/docker-compose.prod.yml --env-file .env.production up -d --scale chat=2
ExecStop=/usr/bin/docker compose -f deploy/aws/docker-compose.prod.yml --env-file .env.production down
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
