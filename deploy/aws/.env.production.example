# Copy to .env.production on the EC2 host (never commit secrets)

# ── Domain (used by CORS and optional cert scripts) ───────────────────────────
DOMAIN=chat.example.com
CORS_ORIGINS=https://chat.example.com

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=replace-with-openssl-rand-hex-32
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_USER=webchat
POSTGRES_PASSWORD=replace-strong-password
POSTGRES_DB=webchat

# ── RabbitMQ ──────────────────────────────────────────────────────────────────
RABBITMQ_USER=webchat
RABBITMQ_PASS=replace-strong-password

# ── Database & Infrastructure Hosts (for distributed multi-instance setup) ────
# For single-node: leave commented out (defaults to postgres, mongo, redis, rabbitmq)
# For multi-node: set to the private IP of the Database/Infra Node
# POSTGRES_HOST=10.0.0.10
# MONGO_HOST=10.0.0.10
# REDIS_HOST=10.0.0.10
# RABBITMQ_HOST=10.0.0.10

# ── AWS S3 (uploads — stays on free tier for demo traffic) ────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=webchat-uploads
S3_PUBLIC_BUCKET=false

# ── Search (leave empty to use MongoDB regex — saves ~512MB RAM) ──────────────
# ELASTICSEARCH_URL=http://elasticsearch:9200
ES_INDEX=webchat-messages

# ── Frontend build (leave empty for same-origin nginx proxy) ──────────────────
VITE_API_BASE=
VITE_CHAT_URL=

# ── Grafana (monitoring profile only) ─────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=replace-grafana-password
GRAFANA_ROOT_URL=https://chat.example.com/grafana

# ── GitHub Actions deploy (optional) ──────────────────────────────────────────
# DEPLOY_HOST=1.2.3.4
# DEPLOY_USER=ubuntu
